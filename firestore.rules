rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }

    // Profile: only the owner can read or write it.
    match /users/{uid} {
      allow read, delete: if isUser(uid);
      allow write: if isUser(uid)
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.age is number
        && request.resource.data.height is number
        && request.resource.data.weight is number;

      // Weekly check-off and weight logs are private.
      match /logs/{logId} {
        allow read, write: if isUser(uid);
      }

      // Likes: created/deleted only together with a matching +1/-1 on the program's likeCount.
      match /likes/{programId} {
        function likes(p) { return p.data.get('likeCount', 0); }
        function program() { return /databases/$(database)/documents/programs/$(programId); }
        allow read: if isUser(uid);
        allow create: if isUser(uid) && likes(getAfter(program())) == likes(get(program())) + 1;
        allow delete: if isUser(uid) && likes(getAfter(program())) == likes(get(program())) - 1;
      }
    }

    match /programs/{id} {
      function valid(d) {
        return d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.visibility in ['private', 'public']
          && d.days is list && d.days.size() == 7;
      }
      function likes(d) { return d.get('likeCount', 0); }
      function likeDoc() { return /databases/$(database)/documents/users/$(request.auth.uid)/likes/$(id); }
      // Anyone who can see the program may move likeCount by exactly 1, paired with their own like doc.
      function likeToggle() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && (resource.data.visibility == 'public' || resource.data.ownerId == request.auth.uid)
          && ((likes(request.resource.data) == likes(resource.data) + 1 && !exists(likeDoc()) && existsAfter(likeDoc()))
            || (likes(request.resource.data) == likes(resource.data) - 1 && exists(likeDoc()) && !existsAfter(likeDoc())));
      }

      // Everything requires sign-in; public programs are readable by any signed-in user.
      allow read: if signedIn()
        && (resource.data.visibility == 'public' || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && likes(request.resource.data) == 0
        && valid(request.resource.data);
      allow update: if signedIn() && (likeToggle() || (
        resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && likes(request.resource.data) == likes(resource.data)
        && valid(request.resource.data)));
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
