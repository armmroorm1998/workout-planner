rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }

    // Profile: only the owner can read or write it.
    match /users/{uid} {
      allow read, delete: if isUser(uid);
      allow write: if isUser(uid)
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.age is number
        && request.resource.data.height is number
        && request.resource.data.weight is number;

      // Weekly check-off and weight logs are private.
      match /logs/{logId} {
        allow read, write: if isUser(uid);
      }
    }

    match /programs/{id} {
      function valid(d) {
        return d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.visibility in ['private', 'public']
          && d.days is list && d.days.size() == 7;
      }

      // Everything requires sign-in; public programs are readable by any signed-in user.
      allow read: if signedIn()
        && (resource.data.visibility == 'public' || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && valid(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && valid(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
